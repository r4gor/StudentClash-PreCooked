# ---------- LLM: ONE key. Claude (Sonnet reasons, Haiku talks) or Gemini (3.5 Flash reasons, 3.5 Flash Lite talks) ----------
# PYTHAGORAS_PROVIDER=gemini            # anthropic | openrouter | gemini (default: whichever key is set, Claude first)
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=                # openrouter.ai, paid per token: default anthropic/claude-sonnet-5.5 + claude-haiku-5.5
# GEMINI_API_KEY=                    # aistudio.google.com; free tier may use prompts for training: not for real student data
# PYTHAGORAS_REASONER_MODEL=            # default claude-sonnet-5-5 / gemini-3.5-flash
# PYTHAGORAS_TALKER_MODEL=              # default claude-haiku-5-5 / gemini-3.5-flash-lite
# PYTHAGORAS_JUDGE_MODEL=               # judges each answer live; default = talker model on Gemini, reasoner on Claude
# Gemini FREE tier: ~20 requests/DAY on Flash (1 plan + 1 report per interview). When it runs out (429), set
# PYTHAGORAS_REASONER_MODEL=gemini-3.5-flash-lite for the day, or use a paid key.
# PYTHAGORAS_FAKE_LLM=1                 # offline stub, no key needed (UI work, tests)

# ---------- App ----------
PYTHAGORAS_PROFESSOR_PASSWORD=                 # empty: the professor pages are open (MVP); set one to require a login
PYTHAGORAS_SECRET=change-me            # signs the professor cookie
PYTHAGORAS_PUBLIC_URL=http://localhost:8000   # base of the invite links in the emails
PYTHAGORAS_DURATION_S=600
# PYTHAGORAS_LANGUAGE=en                # en | it: what Pythagoras speaks, hears and writes (plan, questions, report)
# PYTHAGORAS_CAMERA=1                  # 1: the team's webcam is on during the interview, with a visual-only REC badge (never recorded)
# PYTHAGORAS_TOPICS=3                  # topics per interview
# PYTHAGORAS_SPECULATE=1                # 1: phrase the likely next question while the judge works (faster turns, a few more talker calls)
# PYTHAGORAS_DEMO_RULES=1               # 1 (default for now): a good first answer on the weights topic climbs to level 3; "I don't know" gets one retry, a second one moves on

# ---------- Voice ----------
# auto: natural local voice when the `voice` extra is installed (Apple Silicon), else the browser's speech APIs
# PYTHAGORAS_VOICE=auto                 # auto | local | browser
# PYTHAGORAS_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo   # whisper-small-mlx is ~0.5 s faster, less accurate
# PYTHAGORAS_KOKORO_VOICE=af_heart      # en: af_heart, am_michael, bf_emma... · it: im_nicola, if_sara
# PYTHAGORAS_KOKORO_SPEED=1.0
# The answer ends only on "I'm done": the three settings below tune audio.TurnDetector, which the live interview no longer uses to close a turn
# PYTHAGORAS_SMART_TURN_SILENCE_S=1.0   # pause after which a finished sentence ends the turn
# PYTHAGORAS_SILENCE_S=2.5              # silence that ends the turn even if the sentence sounds unfinished
# PYTHAGORAS_SMART_TURN=off             # only the silence rule
# PYTHAGORAS_DATA_DIR=data

# ---------- Email (invite links). Unset: mails go to data/outbox/ and the link is shown on screen ----------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
